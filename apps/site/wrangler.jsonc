{
  // Static-assets-only Worker: no script, Cloudflare serves the Astro build.
  // https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uh-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The agenticeng.app zone must live on the same Cloudflare account as
  // CLOUDFLARE_ACCOUNT_ID. Wrangler creates the DNS record and certificate.
  "routes": [{ "pattern": "uh.agenticeng.app", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": false },
  "env": {
    // `wrangler deploy --env preview` publishes the Worker `uh-site-preview`
    // on workers.dev only: no custom domain, so a preview never touches
    // uh.agenticeng.app. Pull requests deploy here (see deploy-site.yml).
    "preview": {
      "routes": [],
      "workers_dev": true
    }
  }
}
